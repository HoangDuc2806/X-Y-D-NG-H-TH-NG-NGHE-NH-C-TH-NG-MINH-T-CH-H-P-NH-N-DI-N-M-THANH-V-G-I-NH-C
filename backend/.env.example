ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# API /me: Project URL và Publishable key (cũng chấp nhận legacy anon key)
SUPABASE_URL=https://npwuxkvkgbgfltgekvzg.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_pk4FPcKvK96NPRmVQdUUaw_6R64AgJR
# Chỉ phục vụ Alembic từ máy quản trị: URI Postgres của Supabase (mật khẩu KHÔNG commit)
# DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Spotify catalog search: tạo app tại https://developer.spotify.com/dashboard
# Giữ cả hai giá trị ở backend; KHÔNG đặt Client Secret trong frontend/.env.local
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Nhận diện âm nhạc (đăng ký ứng dụng tại https://acoustid.org/new-application)
ACOUSTID_CLIENT_KEY=
# Đường dẫn fpcalc; trên Windows có thể dùng C:\tools\chromaprint\fpcalc.exe
CHROMAPRINT_FPCALC_PATH=fpcalc
RECOGNITION_MAX_UPLOAD_BYTES=20971520
RECOGNITION_FINGERPRINT_LENGTH_SECONDS=120
RECOGNITION_MIN_DURATION_SECONDS=5
RECOGNITION_MAX_DURATION_SECONDS=1800
